          "tasks": [
            { "type": "flag", "target": "MET_CRANE", "value": 1 },
            { "type": "flag", "target": "MET_COLES", "value": 1 },
            { "type": "flag", "target": "MET_MAIR", "value": 1 }
          ]
        }
      ],
      "flags_on_complete": {
        "FLG_LEDGER_FOUND": 1
      }
    },
    {
      "id": "Q-M-C2a",
      "title": "The Miller and the Salt",
      "chapter": "C2 (opening)",
      "day_window_min": 2,
      "day_window_max": 9,
      "auto_start": true,
      "objectives": [
        {
          "id": "OBJ-C2-SCENE",
          "description": "Reach the mill on Afon Ddu and record the scene.",
          "optional": false,
          "tasks": [
            { "type": "reach", "target": "AREA-MILL" },
            { "type": "collect", "target": "EVD-NOTT-BODY" },
            { "type": "observe", "target": "EVD-FOOTPRINTS" }
          ]
        },
        {
          "id": "OBJ-C2-EVID",
