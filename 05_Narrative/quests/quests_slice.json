            { "type": "inspect", "target": "EVD-DISH" },
            { "type": "inspect", "target": "EVD-LEDGER" },
            { "type": "inspect", "target": "EVD-TORN-PAGE" }
          ]
        },
        {
          "id": "OBJ-C1-BOARD",
