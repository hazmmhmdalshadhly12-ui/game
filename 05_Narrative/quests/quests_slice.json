          "optional": false,
          "tasks": [
            { "type": "collect", "target": "EVD-SCALE-WEIGHTS" },
            { "type": "collect", "target": "EVD-SALT-SACK" }
          ]
        },
        {
          "id": "OBJ-C2-TABLE",
          "description": "Examine the scene notes and the weights on the father's table.",
          "optional": false,
          "tasks": [
            { "type": "inspect", "target": "EVD-NOTT-BODY" },
            { "type": "inspect", "target": "EVD-SCALE-WEIGHTS" }
          ]
        },
        {
          "id": "OBJ-C2-BOARD",
          "description": "Name the pattern: the first death follows a registered sin.",
          "optional": false,
          "tasks": [
            { "type": "insight", "target": "INS-PATTERN" }
          ]
        },
        {
          "id": "OBJ-C2-COLES",
          "description": "Optional: the gravedigger knows the miller's fraud.",
          "optional": true,
          "tasks": [
            { "type": "collect", "target": "EVD-COLES-FRAUD" }
          ]
        }
      ],
      "flags_on_complete": {
        "FLG_CASE_OPENED": 1
      }
