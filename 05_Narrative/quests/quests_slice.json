          "optional": false,
          "tasks": [
            { "type": "reach", "target": "AREA-COTTAGE" },
            { "type": "collect", "target": "EVD-LEDGER" },
            { "type": "collect", "target": "EVD-RITE-PAPER" },
            { "type": "collect", "target": "EVD-TORN-PAGE" }
          ]
