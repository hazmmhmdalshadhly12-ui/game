          "tasks": [
            { "type": "reach", "target": "AREA-CHURCHYARD" },
            { "type": "observe", "target": "EVD-GRAVE" }
          ]
        },
        {
          "id": "OBJ-C1-DISH",
          "description": "Find what remains at the boundary stone.",
          "optional": false,
          "tasks": [
            { "type": "reach", "target": "AREA-BOUNDARY" },
            { "type": "collect", "target": "EVD-DISH" }
          ]
        },
        {
          "id": "OBJ-C1-COTTAGE",
